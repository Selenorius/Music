setcps (60/60/4)

d1 $ n (fmap (*2.5) $ run 16)
# s "drum"
# octave 9
# legato 0.3
# gain 0.95
# decay 0.88
# room 0.25
# size 0.88

d1 silence

d2 $ n "3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3"
# s "drum"
# legato 0.3
# gain 1.1
# decay 0.88
# room 0.25
# size 0.99

d2 silence

d3 $ cat [
    n "0 ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~",
    n "0 ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~ 0 0 ~ ~"
]
# s "super808"
# gain 1.3
# decay 0.88
# room 0.25
# size 0.25

d3 silence

d4 $ cat [
    n "-5 -1 0 2",
    n "4 11 7 4"
]
