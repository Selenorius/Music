setcps (60/60/4)

d1 $ n (fmap (*2.5) $ run 16)
# s "drum"
# octave 9
# legato 0.3
# gain 0.95
# decay 0.88
# room 0.25
# size 0.88

d1 silence

d2 $ n "3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3"
# s "drum"
# legato 0.3
# gain 1.1
# decay 0.88
# room 0.25
# size 0.99

d2 silence

d3 $ cat [
    n "0 ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~ 0 ~ ~ ~",
    n "0 ~ ~ ~ 0 ~ ~ ~ ~ ~ ~ ~ 0 0 ~ ~"
]
# s "super808"
# gain 1.3
# decay 0.88
# room 0.25
# size 0.25

d3 silence

d4 $ cat [
    n "-5 -1 0 [4 -1] 2 4 11 ~ -1 0 [0 9] 4 -1 ~ ~ ~",
    n "11 7 4 0 _ -1 -5 _"
]
# s "superpiano"
# octave "<6 _ _ _ 5 _ _ _>"
# legato "15"
# gain "0.44"
# room "0.88"
# size "0.88"
# velocity "5"
# lfo "0.1"
# voice "<0.4 _ _ _ 0.8 _ _ _>"
# djf "0.35"

d4 silence

d5 $ cat [
    n "~",
    n "-5 -1 0 [4 -1] 2 4 11 ~ -1 0 [0 9] 4 -1 ~ ~ ~"
]
# s "superkick"
# octave 6
# gain 0.88
# decay 0.88
# legato 48
# room 0.5
# size 0.99

d5 silence

d6 $ cat [
    n "0",
    n "-3 4 _ [2 2 _ _]"
]
# s "supersquare"
# octave 3
# gain 1.5
# room 0.25
# size 0.75
# lfo 0.1

d6 silence

hush

panic