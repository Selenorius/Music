d5 silence

d6 $ cat [
    n "-1 2 4 7 2 4 7 9 -1 2 4 7 2 4 7 9",
    n "11 14 11 9 11 14 9 7 11 14 11 9 11 14 9 7",
    n "-1 2 4 7 2 4 7 9 -1 2 4 7 2 4 7 9",
    n "11 14 11 9 11 14 9 7 11 14 11 9 11 14 9 7"
]
